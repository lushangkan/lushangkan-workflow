#!/usr/bin/env bash
# workflow next — 每天开工一条命令：领当前 Project 里优先级最高的未指派票。
#
# 用法:
#   workflow-next                      领票并指派给 OMP Implementer（立即开工）
#   workflow-next --agent "PI Researcher"   换执行 Agent
#   workflow-next --no-start           只占票不启动
#   workflow-next --project <uuid前缀>  只看某个 Project
#
# Multica 没有原子 claim-next；这个包装 = 两次 CLI 调用（list + assign）。
# 单人场景够用；多人同时抢票会有竞争。
set -euo pipefail

PROFILE="desktop-api.multica.ai"
AGENT="OMP Implementer"
NO_START=""
PROJECT=""

while [ $# -gt 0 ]; do
  case "$1" in
    --agent)    AGENT="$2"; shift 2 ;;
    --no-start) NO_START="--no-start"; shift ;;
    --project)  PROJECT="$2"; shift 2 ;;
    -h|--help)  sed -n '2,13p' "$0"; exit 0 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

LIST_ARGS=(--profile "$PROFILE" issue list --status todo --output json)
[ -n "$PROJECT" ] && LIST_ARGS+=(--project "$PROJECT")

NEXT=$(multica "${LIST_ARGS[@]}" | jq -r '
  def pr: {urgent:0, high:1, medium:2, low:3, none:4};
  [ .issues[] | select(.assignee_id == null) ]
  | sort_by(pr[.priority] // 4, .position)
  | .[0] // empty
  | "\(.identifier)\t\(.title)\t\(.priority)\t\(.project_id // "-")"')

if [ -z "$NEXT" ]; then
  echo "当前没有可领的票（todo 且无 assignee）。"
  exit 1
fi

IFS=$'\t' read -r KEY TITLE PRIO PROJ <<< "$NEXT"
echo "领票: $KEY  [$PRIO]  $TITLE"
multica --profile "$PROFILE" issue assign "$KEY" --to "$AGENT" $NO_START --output json \
  | jq -r '"指派给: \(.assignee_name // "'"$AGENT"'")  状态: \(.status)"'
